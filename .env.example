# Copy to .env and fill in. Never commit .env.

# --- LLM providers ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Fallback chain, e.g. deepseek:deepseek-chat,anthropic:claude-sonnet-5
LLM_CHAIN=
# Optional local LLM on the Windows host
OLLAMA_LLM_BASE_URL=

# --- App ---
APP_ENV=
SECRET_KEY=

# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Redis / RabbitMQ ---
REDIS_URL=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
CELERY_BROKER_URL=

# --- Vector store / embeddings / rerank ---
QDRANT_URL=
OLLAMA_BASE_URL=
EMBEDDING_MODEL=
RERANKER_URL=

# --- Observability (Langfuse Cloud) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
