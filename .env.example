# Copy to .env and fill in. Never commit .env.
# compose.yaml читает отсюда пароли хранилищ и ключи; остальные адреса задаются в compose.

# --- LLM ---
DEEPSEEK_API_KEY=
# Модель ответов: deepseek-flash | deepseek-v4-pro (список: GET https://api.deepseek.com/models)
LLM_MODEL=deepseek-flash
# Уровень рассуждений: low | high | max; пусто — параметр не передаётся провайдеру
LLM_REASONING_EFFORT=low
LLM_BASE_URL=
# Fallback-провайдеры (итерация 7)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_CHAIN=
# Локальный LLM на Windows-хосте (итерация 7)
OLLAMA_LLM_BASE_URL=

# --- PostgreSQL (любые значения; пароль сгенерируйте: openssl rand -hex 16) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# --- Qdrant ---
# int8-квантизация векторов в RAM. Только на CPU с AVX: в VM без AVX Qdrant падает (SIGILL)
QDRANT_QUANTIZATION=false

# --- Embeddings ---
# По умолчанию Ollama поднимается в контейнере (профиль local-ollama, модель скачается сама).
# Свой Ollama на хосте: уберите COMPOSE_PROFILES и укажите его адрес, например
# http://host.docker.internal:11434 (Docker Desktop) или http://10.0.2.2:11434 (VirtualBox NAT).
# Нужен CPU с AVX: без него llama.cpp в контейнере не работает — тогда Ollama на хосте.
COMPOSE_PROFILES=local-ollama
OLLAMA_BASE_URL=http://ollama:11434
# Тег модели Ollama (зафиксирован: смена весов = переиндексация)
EMBEDDING_MODEL=
# Потоки llama.cpp; для local-ollama = 3 (cpus контейнера), для хоста — пусто
EMBEDDING_NUM_THREAD=3

# --- App ---
LOG_LEVEL=
# Адрес публикации веб-админок (Qdrant Dashboard, RabbitMQ UI, Flower, pgweb, RedisInsight):
# пусто = 127.0.0.1 (только SSH-туннель); 192.168.56.10 = открыть в host-only сеть для Windows
ADMIN_UI_BIND=
# Seed-администратор (`make seed`): владелец агентов итерации 1. С паролем — можно войти в UI,
# им же пользуются scripts/smoke.py и demo_traffic.py. Сгенерируйте: openssl rand -hex 12
SEED_USER_EMAIL=owner@local
SEED_USER_PASSWORD=
# true — cookie сессии только по HTTPS (за reverse-proxy с TLS); в dev по http — false
SESSION_COOKIE_SECURE=false

# --- Observability (Langfuse Cloud) ---
# Пусто = трейсинг выключен (no-op). Ключи: Langfuse → Project Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com, US: https://us.cloud.langfuse.com (старое имя: LANGFUSE_HOST)
LANGFUSE_BASE_URL=
